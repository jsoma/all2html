{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": false,
    "noEmit": true,
    "esModuleInterop": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/jsx/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "dist"]
}
